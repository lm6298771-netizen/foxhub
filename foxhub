task.spawn(function()
    while St.R and _G.FoxLoop do
        pcall(function()
            if _G.FoxTimer then
                local achou=false
                for _,g in pairs(L.PlayerGui:GetDescendants())do
                    if g:IsA("TextLabel") or g:IsA("TextButton")then
                        local m=string.match(g.Text,"(%d+:%d+)")
                        if m then
                            local l=string.lower(g.Text)
                            if string.find(l,"proximo") or string.find(l,"próximo") or string.find(l,"next") or string.find(l,"evento")then
                                _G.FoxTimer.Text="⏰ "..m achou=true break
                            end
                        end
                    end
                end
                if not achou then
                    local PG=L:WaitForChild("PlayerGui")
                    local mainGui=PG:FindFirstChild("MainGUI")
                    if mainGui then
                        for _,g in pairs(mainGui:GetDescendants())do
                            if g:IsA("TextLabel")then
                                local m=string.match(g.Text,"(%d+:%d+)")
                                if m then _G.FoxTimer.Text="⏰ "..m achou=true break end
                            end
                        end
                    end
                    if not achou then _G.FoxTimer.Text="⏰ --:--" end
                end
            end
        end)
        task.wait(1)
    end
end)

local function pecaAlta(obj)
    local alta,maiorY=nil,-9999
    for _,p in ipairs(obj:GetDescendants())do
        if p:IsA("BasePart")and p.Position.Y>maiorY then maiorY=p.Position.Y alta=p end
    end
    return alta
end

local function acharTerreno()
    local nome=string.lower(L.Name)
    local display=string.lower(L.DisplayName or "")
    local id=tostring(L.UserId)
    for _,obj in ipairs(W:GetDescendants())do
        if obj:IsA("Model")and obj.Parent then
            local n=string.lower(obj.Name)
            if string.find(n,nome)or string.find(n,id)or(display~=""and string.find(n,display))then return obj end
        end
    end
    return nil
end

task.spawn(function()
    while St.R and _G.FoxLoop do
