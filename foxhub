                                    local pA=h.CFrame
                                    h.CFrame=CFrame.new(alta.Position+Vector3.new(0,3,0))
                                    task.wait(0.3)
                                    h.CFrame=pA
                                    task.wait(0.05)
                                end
                            end
                        end
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end)

